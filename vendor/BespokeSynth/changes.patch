+   bool InNoteField(float x, float y);
+   bool MouseScrolled(float x, float y, float scrollX, float scrollY, bool isSmoothScroll, bool isInvertedScroll) override;
+   float mSourceScroll{ 0 }, mSourceContentHeight{ 0 };
