diff --git a/Source/RustelViewAudio.cpp b/Source/RustelViewAudio.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e1a0b889aa4d85c39edab402f8087bf65496f8a9
--- /dev/null
+++ b/Source/RustelViewAudio.cpp
@@ -0,0 +1,225 @@
+#include "RustelView.h"
+#include "RustelLink.h"
+#include "OpenFrameworksPort.h"
+#include <algorithm>
+#include <cmath>
+
+void RustelView::PollAudio()
+{
+   auto frames = RustelLink::Analysis();
+   auto* list = frames.getArray();
+   if (!list)
+      return;
+   for (const auto& frame : *list)
+   {
+      if (frame["session"].toString().toStdString() != mSessionId || int(frame["version"]) != 1)
+         continue;
+      uint64_t sequence = int64_t(frame["sequence"]);
+      if (sequence <= mAudioSequence)
+         continue;
+      auto* scope = frame["scope"].getArray();
+      auto* spectrum = frame["spectrum"].getArray();
+      auto* sides = frame["sides"].getArray();
+      int rate = int(frame["sample_rate"]);
+      if (!scope || !spectrum || !sides || scope->size() != 512 || spectrum->size() != 512 || sides->size() > 4096 || rate <= 0)
+         continue;
+      std::vector<float> wave, bins;
+      std::vector<ofVec2f> stereo;
+      bool valid = true;
+      for (const auto& value : *scope)
+      {
+         float v = float(value);
+         if (!std::isfinite(v))
+         {
+            valid = false;
+            break;
+         }
+         wave.push_back(v);
+      }
+      for (const auto& value : *spectrum)
+      {
+         float v = float(value);
+         if (!std::isfinite(v))
+         {
+            valid = false;
+            break;
+         }
+         bins.push_back(std::clamp(v, -120.0f, 12.0f));
+      }
+      for (const auto& pair : *sides)
+      {
+         auto* values = pair.getArray();
+         if (!values || values->size() != 2)
+         {
+            valid = false;
+            break;
+         }
+         float l = float((*values)[0]), r = float((*values)[1]);
+         if (!std::isfinite(l) || !std::isfinite(r))
+         {
+            valid = false;
+            break;
+         }
+         stereo.emplace_back(l, r);
+      }
+      if (!valid)
+         continue;
+      uint64_t stream = int64_t(frame["stream_id"]), epoch = int64_t(frame["epoch"]);
+      int64_t generation = int64_t(frame["generation"]);
+      if (stream != mAudioStream || epoch != mAudioEpoch || generation != mAudioGeneration)
+      {
+         mSpectrumBars.fill(0);
+         mSpectrumPeaks.fill(0);
+      }
+      mAudioSequence = sequence;
+      mAudioStream = stream;
+      mAudioEpoch = epoch;
+      mAudioGeneration = generation;
+      mAudioSampleRate = rate;
+      mAudioScope = std::move(wave);
+      mAudioSpectrum = std::move(bins);
+      mAudioSides = std::move(stereo);
+      mAudioReceived = juce::Time::getMillisecondCounterHiRes();
+   }
+}
+
+void RustelView::DrawAudioView(float top, float bottom, double dt)
+{
+   ofPushStyle();
+   ofPushMatrix();
+   ofClipWindow(2, top, mWidth - 4, bottom - top, true);
+   const float left = 46, right = mWidth - 20, width = right - left, edge = top + 20, height = bottom - edge - 24;
+   auto transform = [&](float x, float y)
+   {
+      float cx = mWidth * 0.5f, cy = top + (bottom - top) * 0.65f;
+      return ofVec2f(cx + (x - cx) * mZoom + mPanX * mWidth, cy + (y - cy) * mZoom + mPanY * (bottom - top));
+   };
+   auto line = [&](float x, float y, float a, float b, ofColor c, float w = 1.0f)
+   {
+      auto p = transform(x, y), q = transform(a, b);
+      ofSetColor(c);
+      ofSetLineWidth(w);
+      ofLine(p.x, p.y, q.x, q.y);
+   };
+   auto text = [&](std::string s, float x, float y, ofColor c)
+   {
+      auto p = transform(x, y);
+      ofSetColor(c);
+      DrawTextNormal(s, p.x, p.y, 10);
+   };
+   bool fresh = juce::Time::getMillisecondCounterHiRes() - mAudioReceived < 1000 && mAudioGeneration == mGeneration && mAudioSampleRate > 0;
+   if (!fresh)
+   {
+      ofSetColor(140, 165, 185);
+      DrawTextNormal("Waiting for live master audio from Rustel...", 20, int(top + 40));
+      ofPopMatrix();
+      ofPopStyle();
+      return;
+   }
+   if (mViewMode == 5)
+   {
+      for (int i = 0; i < 5; ++i)
+      {
+         float y = edge + height * i / 4;
+         line(left, y, right, y, ofColor(40, 60, 85, 140));
+         text(ofToString(1.0 - i * 0.5, 1), 8, y + 3, ofColor(110, 140, 170));
+      }
+      for (int i = 0; i < 9; ++i)
+      {
+         float x = left + width * i / 8;
+         line(x, edge, x, edge + height, ofColor(35, 55, 75, 100));
+      }
+      size_t start = 0;
+      for (size_t i = 1; i + 256 < mAudioScope.size(); ++i)
+      {
+         if (mAudioScope[i - 1] <= 0 && mAudioScope[i] > 0)
+         {
+            start = i;
+            break;
+         }
+      }
+      size_t count = std::min<size_t>(256, mAudioScope.size() - start);
+      for (size_t i = 1; i < count; ++i)
+      {
+         float x = left + width * float(i - 1) / float(count - 1), nx = left + width * float(i) / float(count - 1);
+         float y = edge + height * 0.5f - mAudioScope[start + i - 1] * mDisplayGain * height * 0.5f;
+         float ny = edge + height * 0.5f - mAudioScope[start + i] * mDisplayGain * height * 0.5f;
+         line(x, y, nx, ny, ofColor(35, 220, 190, 45), 5);
+         line(x, y, nx, ny, ofColor(100, 255, 220), 1.5f);
+      }
+      text("rising-edge trigger / display x" + ofToString(mDisplayGain, 1), left, edge + height + 15, ofColor(120, 165, 180));
+   }
+   else if (mViewMode == 6)
+   {
+      const float nyquist = mAudioSampleRate * 0.5f, minimum = 20, maximum = std::min(20000.0f, nyquist);
+      for (int db = -90; db <= 0; db += 30)
+      {
+         float y = edge + height * (1 - (db + 90) / 90.0f);
+         line(left, y, right, y, ofColor(40, 60, 85, 140));
+         text(ofToString(db), 8, y + 3, ofColor(110, 140, 170));
+      }
+      float gainDb = 20 * std::log10(mDisplayGain);
+      float smooth = 1 - std::exp(-float(dt) * 18);
+      for (int i = 0; i < 64; ++i)
+      {
+         float low = minimum * std::pow(maximum / minimum, i / 64.0f), high = minimum * std::pow(maximum / minimum, (i + 1) / 64.0f);
+         int a = std::clamp(int(low / nyquist * 512), 0, 511), b = std::clamp(int(std::ceil(high / nyquist * 512)), a + 1, 512);
+         float db = -120;
+         for (int bin = a; bin < b; ++bin)
+            db = std::max(db, mAudioSpectrum[bin]);
+         float level = std::clamp((db + gainDb + 90) / 90, 0.0f, 1.0f);
+         mSpectrumBars[i] += (level - mSpectrumBars[i]) * smooth;
+         mSpectrumPeaks[i] = std::max(mSpectrumBars[i], mSpectrumPeaks[i] - float(dt) * 0.2f);
+         auto p = transform(left + i * width / 64, edge + height * (1 - mSpectrumBars[i]));
+         ofFill();
+         ofSetColor(40 + i * 2, 220 - i, 210);
+         ofRect(p.x, p.y, std::max(1.0f, (width / 64 - 2) * mZoom), height * mSpectrumBars[i] * mZoom, 1);
+         line(left + i * width / 64, edge + height * (1 - mSpectrumPeaks[i]), left + (i + 1) * width / 64 - 2, edge + height * (1 - mSpectrumPeaks[i]), ofColor(215, 250, 255), 1);
+      }
+      for (float hz : { 20.0f, 100.0f, 1000.0f, 10000.0f })
+         if (hz < maximum)
+         {
+            float x = left + std::log(hz / minimum) / std::log(maximum / minimum) * width;
+            text(hz >= 1000 ? ofToString(hz / 1000, 0) + "k" : ofToString(hz, 0), x, edge + height + 15, ofColor(130, 165, 185));
+         }
+   }
+   else
+   {
+      if (mAudioSides.size() < 2)
+      {
+         text("No stereo analysis available", left, edge + 30, ofColor(145, 165, 190));
+         ofPopMatrix();
+         ofPopStyle();
+         return;
+      }
+      float cx = left + width * 0.5f, cy = edge + height * 0.5f, radius = height * 0.44f;
+      line(cx - radius, cy, cx + radius, cy, ofColor(55, 80, 105));
+      line(cx, cy - radius, cx, cy + radius, ofColor(55, 80, 105));
+      line(cx - radius, cy, cx, cy - radius, ofColor(35, 60, 85));
+      line(cx, cy - radius, cx + radius, cy, ofColor(35, 60, 85));
+      line(cx + radius, cy, cx, cy + radius, ofColor(35, 60, 85));
+      line(cx, cy + radius, cx - radius, cy, ofColor(35, 60, 85));
+      double ll = 0, rr = 0, lr = 0;
+      ofVec2f previous;
+      bool first = true;
+      for (size_t i = 0; i < mAudioSides.size(); ++i)
+      {
+         float l = mAudioSides[i].x, r = mAudioSides[i].y;
+         ll += l * l;
+         rr += r * r;
+         lr += l * r;
+         float side = (r - l) * 0.70710678f, mid = (l + r) * 0.70710678f;
+         ofVec2f point(cx + side * mDisplayGain * radius, cy - mid * mDisplayGain * radius);
+         if (!first)
+            line(previous.x, previous.y, point.x, point.y, ofColor(80, 235, 215, 35 + int(190 * i / mAudioSides.size())), 1.2f);
+         previous = point;
+         first = false;
+      }
+      double correlation = ll > 1e-12 && rr > 1e-12 ? std::clamp(lr / std::sqrt(ll * rr), -1.0, 1.0) : 0;
+      text("MID", cx - 10, edge + 3, ofColor(130, 165, 185));
+      text("SIDE", cx + radius + 8, cy, ofColor(130, 165, 185));
+      text("correlation " + ofToString(correlation, 2) + " / vertical = mono", left, edge + height + 15, ofColor(140, 185, 195));
+   }
+   ofPopMatrix();
+   ofPopStyle();
+}
diff --git a/Source/RustelViewModes.cpp b/Source/RustelViewModes.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f8688328266a6582da02c2129182d1cfbfb77dfe
--- /dev/null
+++ b/Source/RustelViewModes.cpp
@@ -0,0 +1,228 @@
+#include "RustelView.h"
+#include "OpenFrameworksPort.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+// Native event-driven views. Audio scopes need a separate analysis feed.
+void RustelView::DrawEventView(const std::vector<int>& visible, double cycle, bool live, float top, float bottom)
+{
+   static const std::array<ofColor, 8> colors{ { { 31, 242, 209 }, { 255, 89, 107 }, { 163, 107, 255 }, { 255, 186, 51 }, { 51, 166, 255 }, { 255, 89, 204 }, { 158, 255, 71 }, { 255, 138, 56 } } };
+   static const char* notes[12] = { "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B" };
+   const float width = mWidth - 76, height = bottom - top - 26, left = 52, edge = top + 12;
+   float low = 127, high = 0;
+   for (const auto& event : mEvents)
+   {
+      if (event.rest) continue;
+      if (std::find(visible.begin(), visible.end(), event.lane) == visible.end())
+         continue;
+      if (event.cycle + event.duration < cycle - 1.5 || event.cycle > cycle + 0.5)
+         continue;
+      low = std::min(low, std::min(event.pitch, mTraces ? event.original : event.pitch));
+      high = std::max(high, std::max(event.pitch, mTraces ? event.original : event.pitch));
+   }
+   if (low > high)
+   {
+      low = 36;
+      high = 84;
+   }
+   low = std::clamp(std::floor(low / 12) * 12, -24.0f, 120.0f);
+   high = std::clamp(std::max(low + 24, std::ceil((high + 1) / 12) * 12), low + 24, 144.0f);
+   auto transform = [&](float x, float y)
+   {
+      const float cx = mWidth * 0.5f, cy = top + (bottom - top) * 0.65f;
+      return ofVec2f(cx + (x - cx) * mZoom + mPanX * mWidth, cy + (y - cy) * mZoom + mPanY * (bottom - top));
+   };
+   auto line = [&](float x, float y, float a, float b, ofColor color, float thickness = 1.0f)
+   {
+      auto p = transform(x, y), q = transform(a, b);
+      ofSetColor(color);
+      ofSetLineWidth(thickness);
+      ofLine(p.x, p.y, q.x, q.y);
+   };
+   auto circle = [&](float x, float y, float radius, ofColor color, bool filled)
+   {
+      auto p = transform(x, y);
+      ofSetColor(color);
+      ofSetLineWidth(1.2f);
+      if (filled)
+         ofFill();
+      else
+         ofNoFill();
+      ofCircle(p.x, p.y, radius * mZoom);
+   };
+   auto text = [&](const std::string& label, float x, float y, ofColor color)
+   {
+      auto p = transform(x, y);
+      ofSetColor(color);
+      DrawTextNormal(label, p.x, p.y, 10);
+   };
+   auto rect = [&](float x, float y, float w, float h, ofColor color)
+   {
+      auto p = transform(x, y);
+      ofFill();
+      ofSetColor(color);
+      ofRect(p.x, p.y, w * mZoom, h * mZoom, 1);
+   };
+   auto pitchX = [&](float p)
+   {
+      return left + (p - low) / (high - low) * width;
+   };
+   auto pitchY = [&](float p)
+   {
+      return edge + height - (p - low) / (high - low) * height;
+   };
+   auto timeX = [&](double t)
+   {
+      return left + float(t - cycle + 1.5) / 2 * width;
+   };
+   auto timeY = [&](double t)
+   {
+      return edge + float(0.5 - (t - cycle)) / 2 * height;
+   };
+   const float cx = left + width * 0.5f, cy = edge + height * 0.5f, radius = std::min(width, height) * 0.43f;
+   auto spiral = [&](double t, float p)
+   {
+      float age = float(t - cycle);
+      float r = radius * (0.12f + (age + 1.5f) * 0.39f + (p - low) / (high - low) * 0.08f);
+      float angle = age * TWO_PI - PI * 0.5f;
+      return ofVec2f(cx + std::cos(angle) * r, cy + std::sin(angle) * r);
+   };
+   auto wheel = [&](float p)
+   {
+      float angle = std::fmod(p, 12.0f) / 12 * TWO_PI - PI * 0.5f;
+      float r = radius * (0.3f + 0.65f * (p - low) / (high - low));
+      return ofVec2f(cx + std::cos(angle) * r, cy + std::sin(angle) * r);
+   };
+   ofPushStyle();
+   ofPushMatrix();
+   ofClipWindow(2, top, mWidth - 4, bottom - top, true);
+   if (mViewMode <= 2)
+   {
+      for (int row = 0; row < int(mRows.size()); ++row)
+      {
+         const float rh = std::max(64.0f, height / std::max<size_t>(1, mRows.size()));
+         const float rw = std::max(110.0f, width / std::max<size_t>(1, mRows.size()));
+         for (int pitch = int(low); pitch <= int(high); pitch += 12)
+         {
+            if (mViewMode == 1) {
+               float y = edge + (row + 1) * rh - (pitch-low)/(high-low) * (rh-18);
+               line(left, y, left+width, y, ofColor(35,55,78,100));
+            } else {
+               float x = left + row * rw + (pitch-low)/(high-low) * rw;
+               line(x, edge, x, edge+height, ofColor(35,55,78,100));
+            }
+         }
+      }
+      for (int beat = -6; beat <= 2; ++beat)
+      {
+         double t = (std::floor(cycle * 4) + beat) / 4;
+         if (mViewMode == 1)
+            line(timeX(t), edge, timeX(t), edge + height, ofColor(40, 65, 85, 100));
+         else
+            line(left, timeY(t), left + width, timeY(t), ofColor(40, 65, 85, 100));
+      }
+   }
+   else if (mViewMode == 3)
+   {
+      auto previous = spiral(cycle - 1.5, low);
+      for (int i = 1; i <= 160; ++i)
+      {
+         auto next = spiral(cycle - 1.5 + i / 80.0, low);
+         line(previous.x, previous.y, next.x, next.y, ofColor(55, 80, 110, 140));
+         previous = next;
+      }
+      auto head = spiral(cycle, low);
+      circle(head.x, head.y, 5, ofColor(210, 240, 255), true);
+   }
+   else
+   {
+      for (int ring = 0; ring < 4; ++ring)
+         circle(cx, cy, radius * (0.3f + ring * 0.22f), ofColor(40, 65, 90, 170), false);
+      for (int pitch = 0; pitch < 12; ++pitch)
+      {
+         float a = pitch * TWO_PI / 12 - PI * 0.5f;
+         line(cx, cy, cx + std::cos(a) * radius, cy + std::sin(a) * radius, ofColor(40, 65, 90, 120));
+         text(notes[pitch], cx + std::cos(a) * (radius + 15) - 5, cy + std::sin(a) * (radius + 15) + 3, ofColor(145, 175, 200));
+      }
+   }
+   if (mViewMode <= 2)
+      for (int row = 0; row < int(mRows.size()); ++row)
+      {
+         float rh = std::max(64.0f, height / std::max<size_t>(1, mRows.size()));
+         float rw = std::max(110.0f, width / std::max<size_t>(1, mRows.size()));
+         if (mViewMode == 1) {
+            line(left, edge + row * rh, left + width, edge + row * rh, ofColor(40, 65, 85, 120));
+            text(mRows[row].label, left, edge + row * rh + 12, RowColor(row));
+         } else text(mRows[row].label, left + row * rw, edge + 12, RowColor(row));
+      }
+   int rendered = 0;
+   if (live)
+      for (const auto& event : mEvents)
+      {
+         if (std::find(visible.begin(), visible.end(), event.lane) == visible.end() || event.cycle + event.duration < cycle - 1.5 || event.cycle > cycle + 0.5)
+            continue;
+         if (rendered++ >= 1024)
+            break;
+         const int row = EventRow(event);
+         if (row < 0) continue;
+         if (event.rest && mViewMode >= 3) continue;
+         const float rowHeight = std::max(64.0f, height / std::max<size_t>(1, mRows.size()));
+         const float rowWidth = std::max(110.0f, width / std::max<size_t>(1, mRows.size()));
+         auto rowPitchY = [&](float p) { return edge + (row + 1) * rowHeight - (p-low)/(high-low) * std::max(1.0f, rowHeight-18); };
+         auto rowPitchX = [&](float p) { return left + row * rowWidth + (p-low)/(high-low) * rowWidth; };
+         bool sounding = event.cycle <= cycle && event.cycle + event.duration > cycle;
+         float elapsed = float((cycle - event.cycle) / mCps);
+         float hit = elapsed >= 0 ? std::exp(-elapsed * 7) : 0;
+         for (bool source : { true, false })
+         {
+            if (source && !mTraces)
+               continue;
+            float pitch = source ? event.original : event.pitch;
+            auto color = event.part.empty() ? colors[event.lane % colors.size()] : ofColor(event.partColor[0], event.partColor[1], event.partColor[2]);
+            if (event.rest) color = ofColor(105, 120, 140);
+            color.a = source ? 65 : (sounding ? 255 : 150);
+            if (mViewMode == 1)
+            {
+               float h = std::max(event.part.empty() ? 2.0f : 12.0f, height / (high - low) * 0.75f);
+               rect(timeX(event.cycle), rowPitchY(pitch) - h * 0.5f, std::max(2.0f, float(event.duration) * width / 2), source ? 1.5f : h, color);
+               if (!source) text(event.note, timeX(event.cycle) + 2, rowPitchY(pitch) + 3, ofColor(8, 14, 27));
+               if (!source && !event.part.empty()) text(event.part, timeX(event.cycle) + 2, rowPitchY(pitch) - 9, color);
+            }
+            else if (mViewMode == 2)
+            {
+               float w = std::max(3.0f, width / (high - low) * 0.65f);
+               rect(rowPitchX(pitch) - w * 0.5f, timeY(event.cycle + event.duration), source ? 1.5f : w, std::max(3.0f, float(event.duration) * height / 2), color);
+               if (!source) text(event.note, rowPitchX(pitch) + 4, timeY(event.cycle + event.duration) + 20, color);
+               if (!source && !event.part.empty()) text(event.part, rowPitchX(pitch) + 4, timeY(event.cycle + event.duration) + 10, color);
+            }
+            else if (mViewMode == 3)
+            {
+               auto p = spiral(event.cycle, pitch);
+               auto previous = p;
+               double duration = std::clamp(event.duration, 0.01, 0.5);
+               for (int i = 1; i <= 12; ++i)
+               {
+                  auto next = spiral(event.cycle + duration * i / 12, pitch);
+                  line(previous.x, previous.y, next.x, next.y, color, source ? 0.7f : 2.0f);
+                  previous = next;
+               }
+               circle(p.x, p.y, source ? 2 : 3 + hit * 5, color, !source);
+               if (!source && !event.part.empty()) text(event.part, p.x + 5, p.y - 5, color);
+            }
+            else
+            {
+               auto p = wheel(pitch);
+               if (sounding && !source)
+                  line(cx, cy, p.x, p.y, color, 1.5f);
+               circle(p.x, p.y, source ? 3 : 3 + hit * 7 + event.gain * 2, color, !source);
+            }
+         }
+      }
+   if (mViewMode == 1)
+      line(timeX(cycle), edge, timeX(cycle), edge + height, ofColor(210, 240, 255, 220), 1.5f);
+   if (mViewMode == 2)
+      line(left, timeY(cycle), left + width, timeY(cycle), ofColor(210, 240, 255, 220), 1.5f);
+   ofPopMatrix();
+   ofPopStyle();
+}
