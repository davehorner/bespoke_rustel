+/// Wrap top-level identifier const initializers using AST spans. Scalars, functions,
+/// objects and promises pass unchanged through the host helper. No names are guessed
+/// from strings/comments, and nested/destructured declarations are left alone.
+fn rewrite_pattern_bindings(source: &str) -> String {
+    let allocator = Allocator::default();
+    let parsed = Parser::new(&allocator, source, SourceType::mjs()).parse();
+    if parsed.panicked || !parsed.diagnostics.is_empty() { return source.to_owned(); }
+    let composites = running_calls(source, &["stack", "arrange"]);
+    let mut inserts = Vec::new();
+    for statement in &parsed.program.body {
+        let Statement::VariableDeclaration(declaration) = statement else { continue };
+        if declaration.kind != VariableDeclarationKind::Const { continue; }
+        for binding in &declaration.declarations {
+            let (BindingPattern::BindingIdentifier(name), Some(init)) = (&binding.id, &binding.init) else { continue };
+            // Preserve JS inferred names and scalar/object identity semantics.
+            if matches!(init, Expression::ArrowFunctionExpression(_) | Expression::FunctionExpression(_)
+                | Expression::ClassExpression(_) | Expression::ObjectExpression(_) | Expression::ArrayExpression(_)) { continue; }
+            let span = init.span();
+            let from = span.start as usize;
+            let to = span.end as usize;
+            let fallback = composites.iter().any(|(_, range)| range.start >= from && range.end <= to);
+            inserts.push((from, format!("__rustel_part(\"{}\", (", name.name.as_str())));
+            inserts.push((to, format!("), {fallback})")));
+        }
+    }
+    let mut output = source.to_owned();
+    inserts.sort_by_key(|(at, _)| *at);
+    for (at, text) in inserts.into_iter().rev() { output.insert_str(at, &text); }
+    output
+}
