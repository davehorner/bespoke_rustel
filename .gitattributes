# Normalize text in Git without interpreting image assets as text.
* text=auto
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Keep Windows launch scripts native; other scripts work with LF.
*.cmd text eol=crlf
*.ps1 text eol=lf
*.rs text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.py text eol=lf

# Vendor snapshots and their checksums preserve exact upstream/workspace bytes.
vendor/**/files/** -text whitespace=cr-at-eol
vendor/**/changes.patch -text -whitespace
